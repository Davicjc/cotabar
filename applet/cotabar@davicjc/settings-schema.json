{
  "layout": {
    "type": "layout",
    "pages": [
      "pagina-ias",
      "pagina-barra"
    ],
    "pagina-ias": {
      "type": "page",
      "title": "IAs",
      "sections": [
        "secao-ias",
        "secao-coleta",
        "secao-sobre-ias"
      ]
    },
    "pagina-barra": {
      "type": "page",
      "title": "Barra",
      "sections": [
        "secao-barra",
        "secao-sobre-barra"
      ]
    },
    "secao-ias": {
      "type": "section",
      "title": "Quais IAs aparecem",
      "keys": [
        "ia-claude",
        "ia-agy",
        "ia-codex",
        "ia-copilot",
        "ocultar-ausentes"
      ]
    },
    "secao-coleta": {
      "type": "section",
      "title": "Coleta",
      "keys": [
        "coletar",
        "intervalo"
      ]
    },
    "secao-barra": {
      "type": "section",
      "title": "Na barra",
      "keys": [
        "mostrar",
        "letra-periodo"
      ]
    },
    "secao-sobre-ias": {
      "type": "section",
      "title": "Sobre",
      "keys": [
        "assinatura-ias",
        "github-ias"
      ]
    },
    "secao-sobre-barra": {
      "type": "section",
      "title": "Sobre",
      "keys": [
        "assinatura-barra",
        "github-barra"
      ]
    }
  },
  "ia-claude": {
    "type": "switch",
    "default": true,
    "description": "Claude Code"
  },
  "ia-agy": {
    "type": "switch",
    "default": true,
    "description": "Antigravity (agy)"
  },
  "ia-codex": {
    "type": "switch",
    "default": true,
    "description": "Codex (GPT)"
  },
  "ia-copilot": {
    "type": "switch",
    "default": true,
    "description": "GitHub Copilot"
  },
  "ocultar-ausentes": {
    "type": "switch",
    "default": true,
    "description": "Esconder as que não estão instaladas"
  },
  "coletar": {
    "type": "switch",
    "default": true,
    "description": "Ler as IAs logadas neste usuário",
    "tooltip": "O timer do sistema (sudo ./instalar.sh --root) lê as logadas como root. As duas leituras se juntam sozinhas."
  },
  "intervalo": {
    "type": "spinbutton",
    "default": 5,
    "min": 2,
    "max": 60,
    "step": 1,
    "units": "minutos",
    "description": "Consultar a cada",
    "dependency": "coletar"
  },
  "mostrar": {
    "type": "combobox",
    "default": "ambas",
    "options": {
      "Curta e longa": "ambas",
      "Só a curta (horas / dia)": "curta",
      "Só a longa (semana / mês)": "longa",
      "Só os anéis": "nada"
    },
    "description": "Números ao lado do anel"
  },
  "letra-periodo": {
    "type": "switch",
    "default": true,
    "description": "Letra do período depois da % (H horas, D dia, S semana, M mês)"
  },
  "assinatura-ias": {
    "type": "label",
    "description": "CotaBar 0.2.0 · by davicjc"
  },
  "github-ias": {
    "type": "button",
    "description": "Abrir no GitHub",
    "callback": "abrirGithub"
  },
  "assinatura-barra": {
    "type": "label",
    "description": "CotaBar 0.2.0 · by davicjc"
  },
  "github-barra": {
    "type": "button",
    "description": "Abrir no GitHub",
    "callback": "abrirGithub"
  }
}
